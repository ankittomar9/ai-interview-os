# ==============================================================================
# AI Interview OS — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables for your self-hosted deployment.
# ==============================================================================

# 1. Relational Database Credentials (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# 2. Judge0 Sandbox Dedicated Database (PostgreSQL 13)
JUDGE0_DB_USER=judge0
JUDGE0_DB_PASSWORD=judge0pass
JUDGE0_DB_NAME=judge0

# 3. Frontend & CORS Origin
FRONTEND_ORIGIN=http://localhost:5173

# 4. BYOK Frontier AI Keys (Optional Server Fallback)
# Candidates can also provide their own keys in the frontend via X-InterviewOS-Key header
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# 5. Groq Task-Based Model Routing
GROQ_MODEL_DIALOGUE=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_EVAL=qwen/qwen3.8-27b
GROQ_MODEL_STT=whisper-large-v3-turbo
