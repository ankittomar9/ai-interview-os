# Auto-normalize line endings to LF across source trees
* text=auto eol=lf

# Explicit LF normalization for all source code, markup, and configs
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.properties text eol=lf
Dockerfile* text eol=lf

# Windows command scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.wav binary
*.mp3 binary
*.jar binary
*.tar binary
*.gz binary
*.zip binary
